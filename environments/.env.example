# Copy to .env.dev / .env.production and fill in. Never commit the real files.
NODE_ENV=production
PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=smell_me3_local
DB_SSL=false
DB_SYNC=false
# Apply pending migrations when the API starts.
DB_MIGRATIONS_RUN=true

# >= 32 chars each. Generate: npm run gen:key
JWT_SECRET=
JWT_REFRESH_SECRET=
TOKEN_EXPIRATION_TIME=900
REFRESH_TOKEN_EXPIRY_DAYS=30

RATE_LIMIT_MAX=100

APP_URL=https://smellme.in
WEBSITE_URL=https://smellme.in
ADMIN_URL=https://smellme.in
CORS_EXTRA_ORIGINS=

# 64 hex chars (32 bytes). Must equal VITE_API_ENCRYPTION_KEY in the website and admin builds.
API_ENCRYPTION_KEY=
# Reject plaintext JSON writes (default true in production).
API_REQUIRE_ENCRYPTED_BODY=true

# Cloudflare R2 file storage. Setup, bucket CORS and usage: docs/R2.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=smellme-public
R2_PRIVATE_BUCKET=smellme-private
R2_PUBLIC_URL=https://cdn.smellme.in

GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE_NUMBER=
GUPSHUP_WEBHOOK_TOKEN=

UPI_VPA=
UPI_PAYEE_NAME=SmellMe

# Only for `seed:owner`; remove OWNER_PASSWORD afterwards.
OWNER_NAME=Owner
OWNER_EMAIL=
OWNER_PASSWORD=
