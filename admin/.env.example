# Same origin as the site, so the default is fine.
VITE_API_URL=/api
# Must equal API_ENCRYPTION_KEY on the server. It ships inside the JS bundle, so
# it is obfuscation + replay protection, not a secret. HTTPS is the real protection.
VITE_API_ENCRYPTION_KEY=

# Where the public site lives (for the "View on website" button). Empty = same origin (production).
VITE_WEBSITE_URL=
